## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# MSTest
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Coverage (Coverlet / dotnet-coverage) — nunca versionar saidas locais
# coverage/**/coverage.opencover.xml e coverage/**/*.trx sao gerados a cada dotnet test
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestCoverageReport/
lcov.info
diag.*.log
coverage/
coverage.*
.scannerwork/
.sonarqube/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Secrets / env — nunca versionar
.env
.env.*
*.pem
*.pfx
*.key
*.crt
secrets/
secrets.*
*secret*
appsettings.Production.json
appsettings.Staging.json
appsettings.Local.json
appsettings.Secrets.json
# Rider
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db
